<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout" xmlns:smartForm="sap.ui.comp.smartform" xmlns:smartField="sap.ui.comp.smartfield">
    <Dialog title="Add Alcohol" class="sapUiResponsivePadding" contentWidth="25rem">
        <content>
            <VBox class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">
                <Label text="Name" required="true" />
                <Input id="nameInput" placeholder="Name" value="{selectedAlcohol>/name}" />

                <Label text="Type" required="true" />
                <Input id="typeInput" value="{selectedAlcohol>/type}" />

                <Label text="Age" />
                <Input id="ageInput" value="{selectedAlcohol>/age}" />

                <Label text="Country" />
                <Input id="countryInput" value="{selectedAlcohol>/country}" />

                <Label text="Description" />
                <TextArea id="descriptionInput" value="{selectedAlcohol>/description}" rows="4" />
            </VBox>
        </content>
        <buttons>
            <Button text="Save" type="Emphasized" press="onSaveAlcohol" />
            <Button text="Cancel" press="onCancelAlcohol" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>