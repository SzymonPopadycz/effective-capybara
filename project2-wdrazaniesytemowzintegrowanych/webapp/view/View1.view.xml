<mvc:View controllerName="project1.controller.View1" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:table="sap.ui.table" xmlns:fb="sap.ui.comp.filterbar">
    <Page id="page" title="{i18n>title}">
        <VBox>
            <fb:FilterBar id="filterbar" persistencyKey="alcoholFilterKey" useToolbar="false" filterChange="onFilterChange">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem name="Name" label="Name" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idNameInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="Type" label="Type" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idTypeInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem name="Country" label="Country" groupName="Group1" visibleInFilterBar="true">
                        <fb:control>
                            <Input id="idCountryInput" liveChange="onFilterChange" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <Table id="table" items="{path:'Alcohols>/Alcohols', sorter: {path: 'name'}}" mode="SingleSelectLeft" itemPress="onAlcoholPress" selectionChange="onItemSelected">
                <headerToolbar>
                    <OverflowToolbar id="otbSubheader">
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://add" text="Add Alcohol" tooltip="Add Alcohol" press="onAddAlcohol" />
                        <Button id="removeAlcoholBtn" icon="sap-icon://delete" text="Remove Alcohol" tooltip="Remove Alcohol" press="onDeleteAlcohol" enabled="false" />
                    </OverflowToolbar>
                </headerToolbar>
                
                <columns>
                    <Column>
                        <Text text="{i18n>nameColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>typeColumnTxt}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>countryColumnTxt}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation">
                        <cells>
                            <Text text="{Alcohols>name}" />
                            <Text text="{Alcohols>type}" />
                            <Text text="{Alcohols>country}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
    </Page>
</mvc:View>